{
  "name": "create-mod-modeler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project=smoke",
    "screenshots": "playwright test --project=screenshots",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data": "node scripts/data/build.ts"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@xyflow/react": "^12.12.0",
    "fflate": "^0.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yalps": "^0.6.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
